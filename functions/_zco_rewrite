# _zco_rewrite LINE [MODE]: quote the prompt part of a typed per-model command line.
#
# The result is in REPLY. Returns 0 when the line changed, 1 when it is left as typed. MODE is
# the default line mode (literal, shell or off); a --literal or --shell before the prompt
# overrides it for this line. Pure: needs only the global _zco_cmds (command name -> model).
#
#  1. The first word must be a per-model command name; any other line is left alone.
#  2. The rest is tokenised with ${(z)...}, which expands nothing, while an offset into the raw
#     text is kept. Effort words, options (with their values, which keep normal shell quoting)
#     and -- are consumed with the parser's own classifier; the first other word, or a shell
#     operator, is where the prompt starts.
#  3. literal: the prompt part is the rest of the line. shell: it ends at the first spaced shell
#     operator outside a quoted phrase, and the operator and what follows stay for zsh.
#  4. The prompt part is quoted with ${(qq)...}, unless it is empty, holds only safe characters,
#     or is already exactly one quoted word (which also makes the rewrite idempotent).

emulate -L zsh
setopt extended_glob
local -A zk
_zco_keys

local line=$1 mode= default=${2:-literal}
REPLY=$line

local lead=${(M)line##[[:space:]]##} body first rest
body=${line#$lead}
first=${body%%[[:space:]]*}
[[ $first == [A-Za-z0-9._-]## && -n ${_zco_cmds[$first]+set} ]] || return 1
rest=${body#$first}

# --- 2. find where the prompt starts ----------------------------------------------------
local -a words
words=( ${(z)rest} )
local w uw next
integer i=1 off=1 n=${#rest} start=0 effort_set=0 ended=0

_zco_rewrite_skip() { while (( off <= n )) && [[ ${rest[off]} == [[:blank:]] ]]; do (( off++ )); done }
_zco_rewrite_at() { [[ ${rest[off,off+${#1}-1]} == "$1" ]] }
_zco_rewrite_op() { [[ $1 == (<->|)[\;\&\|\<\>\(\)]* ]] }
_zco_rewrite_open() { local -a t; t=( ${(z)${:-$1 x}} ); (( $#t < 2 )) }   # unterminated quote

while (( i <= $#words )); do
  _zco_rewrite_skip
  w=${words[i]}
  _zco_rewrite_at "$w" || { unfunction -m '_zco_rewrite_*'; REPLY=$line; return 1 }
  if (( ended )) || _zco_rewrite_op "$w"; then
    start=off
    break
  fi
  uw=${(Q)w}
  _zco_classify "$uw" $effort_set
  case $REPLY in
    (end)
      ended=1 ;;
    (effort)
      effort_set=1 ;;
    (flag|unknown)
      if [[ $w != -[A-Za-z0-9_=-]# ]]; then start=off; break; fi
      [[ $uw == --shell ]] && mode=shell
      [[ $uw == --literal ]] && mode=literal ;;
    (value-opt)
      next=${words[i+1]-}
      if (( i == $#words )) || _zco_rewrite_op "$next" || _zco_rewrite_open "$next"; then
        start=off
        break
      fi
      [[ ${zk[long:$uw]:-$uw} == --effort ]] && effort_set=1
      (( off += ${#w} ))
      _zco_rewrite_skip
      _zco_rewrite_at "$next" || { unfunction -m '_zco_rewrite_*'; REPLY=$line; return 1 }
      w=$next
      (( i++ )) ;;
    (value-eq)
      if _zco_rewrite_open "$w"; then start=off; break; fi
      [[ $uw == --effort=* ]] && effort_set=1 ;;
    (*)
      start=off
      break ;;
  esac
  (( off += ${#w} ))
  (( i++ ))
done
unfunction -m '_zco_rewrite_*'
REPLY=$line
(( start )) || return 1

# --- 3. the mode, and the end of the prompt in shell mode ------------------------------
[[ -n $mode ]] || mode=$default
[[ $mode == off ]] && return 1

local prefix=$lead$first${rest[1,start-1]} prompt=${rest[start,-1]} tail= word q=
if [[ $mode == shell ]]; then
  integer j=1 m=${#prompt} ws
  while (( j <= m )); do
    while (( j <= m )) && [[ ${prompt[j]} == [[:space:]] ]]; do (( j++ )); done
    (( j > m )) && break
    ws=j
    while (( j <= m )) && [[ ${prompt[j]} != [[:space:]] ]]; do (( j++ )); done
    word=${prompt[ws,j-1]}
    if [[ -n $q ]]; then
      [[ $word == *$q ]] && q=
      continue
    fi
    if [[ $word == [\'\"]* ]]; then
      q=${word[1]}
      (( ${#word} > 1 )) && [[ $word == ?*$q ]] && q=
      continue
    fi
    if [[ $word == ('|'|'|&'|'||'|'&&'|';'|'&'|'>'|'>>'|'>|'|'&>'|'&>>'|'2>'|'2>>'|'2>&1'|'<') ]] &&
       { (( ws > 1 )) || [[ $prefix == *[[:space:]] ]] }; then
      tail=${prompt[ws,-1]}
      prompt=${prompt[1,ws-1]}
      break
    fi
  done
fi

# --- 4. quote the prompt part when needed ----------------------------------------------
prompt=${${prompt##[[:space:]]##}%%[[:space:]]##}
[[ -z $prompt ]] && return 1
[[ $prompt != *[^[:alnum:][:blank:],._:/@%+-]* ]] && return 1
# Already one quoted word: a single '...' (the '\'' joins of ${(qq)...} allowed), "..." or $'...'
# segment. A word glued from quoted parts and an expansion, like 'x'$(cmd)'y', is prompt text.
local -a t
local inner=
t=( ${(z)prompt} )
if (( $#t == 1 )); then
  case $prompt in
    (\'*\') inner=${${prompt[2,-2]}//\'\\\'\'/}; [[ $inner == *\'* ]] || return 1 ;;
    (\$\'*\') inner=${${prompt[3,-2]}//\\?/}; [[ $inner == *\'* ]] || return 1 ;;
    (\"*\") inner=${${prompt[2,-2]}//\\?/}; [[ $inner == *\"* ]] || return 1 ;;
  esac
fi
[[ $prefix == *[[:space:]] ]] || prefix+=' '
REPLY=$prefix${(qq)prompt}${tail:+ $tail}
[[ $REPLY != "$line" ]]
