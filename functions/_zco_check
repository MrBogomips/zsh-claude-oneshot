# _zco_check TYPE VALUE: validate a non-empty value against a key type from _zco_keys.
# Returns 1 with REPLY describing what was expected; on success REPLY is the value, with booleans
# normalised to true or false. Types not listed here accept any value.

emulate -L zsh
setopt extended_glob

local type=$1 value=$2
case $type in
  (level)
    if [[ $value == (low|medium|high|xhigh|max) ]]; then REPLY=$value; return 0; fi
    REPLY="'$value' is not an effort level (valid: low medium high xhigh max)" ;;
  (bool)
    _zco_bool $value && return 0
    REPLY="'$value' is not a boolean (use true/false, yes/no, on/off or 1/0)" ;;
  (decimal)
    if [[ $value == <->(|.<->) ]]; then REPLY=$value; return 0; fi
    REPLY="'$value' is not a non-negative decimal number" ;;
  (posint)
    if [[ $value == <-> && $value == *[1-9]* ]]; then REPLY=$value; return 0; fi
    REPLY="'$value' is not a positive integer" ;;
  (*)
    REPLY=$value
    return 0 ;;
esac
return 1
